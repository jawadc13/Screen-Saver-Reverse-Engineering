// common.rc - resources every screensaver shares. #included from each
// saver's own .rc file.
#include <windows.h>
#include <commctrl.h>
#include "common_res.h"

1 24 "saver.manifest"   // RT_MANIFEST: common controls v6, like the original

STRINGTABLE
BEGIN
    IDS_ERR_GENERIC         "There was an unspecified problem with this screen saver."
    IDS_ERR_NOGL            "Direct3D 11 could not be initialized.  Please install the latest video driver."
    IDS_ERR_INIT            "Could not initialize the screen saver."
    IDS_ERR_CREATE_DEVICE   "Could not create the Direct3D device."
    IDS_ERR_NO_PIXEL_FORMAT "Could not find any compatible Direct3D devices."
    IDS_ERR_OUT_OF_MEMORY   "Not enough memory."
    IDS_NO_PREVIEW          "No preview available"
END

IDD_DISPLAY_SETTINGS DIALOGEX 0, 0, 260, 186
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Display Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    LISTBOX         IDC_MONITOR_LIST, 7, 7, 70, 110, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP | WS_BORDER
    GROUPBOX        "Video adapter", -1, 84, 4, 169, 46
    LTEXT           "", IDC_MONITOR_INFO, 90, 15, 158, 32
    GROUPBOX        "Monitor usage", -1, 84, 54, 169, 40
    AUTORADIOBUTTON "Display &screen saver on this monitor", IDC_SHOW_SAVER, 90, 65, 158, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Display &nothing on this monitor", IDC_LEAVE_BLACK, 90, 78, 158, 10
    AUTOCHECKBOX    "Show the &same animation on every monitor", IDC_SAME_ON_ALL, 84, 100, 169, 10, WS_GROUP | WS_TABSTOP
    AUTOCHECKBOX    "Show &frame-time graph (diagnostics)", IDC_FRAME_GRAPH, 84, 146, 169, 10, WS_TABSTOP
    LTEXT           "Note: each monitor is drawn by its own graphics card at its own resolution and refresh rate.", -1, 84, 116, 169, 28
    DEFPUSHBUTTON   "OK", IDOK, 146, 165, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 203, 165, 50, 14
END

// Generic settings dialog; simplecfg.cpp positions and labels the rows.
IDD_SIMPLE_CONFIG DIALOGEX 0, 0, 227, 200
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Settings", 1360, 7, 7, 213, 150
    LTEXT           "", 1300, 0, 0, 10, 8
    COMBOBOX        1310, 0, 0, 10, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", 1301, 0, 0, 10, 8
    COMBOBOX        1311, 0, 0, 10, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", 1302, 0, 0, 10, 8
    COMBOBOX        1312, 0, 0, 10, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", 1320, 0, 0, 10, 8
    LTEXT           "", 1340, 0, 0, 10, 8
    CONTROL         "", 1330, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP, 0, 0, 10, 16
    LTEXT           "", 1350, 0, 0, 10, 8
    LTEXT           "", 1321, 0, 0, 10, 8
    LTEXT           "", 1341, 0, 0, 10, 8
    CONTROL         "", 1331, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP, 0, 0, 10, 16
    LTEXT           "", 1351, 0, 0, 10, 8
    LTEXT           "", 1322, 0, 0, 10, 8
    LTEXT           "", 1342, 0, 0, 10, 8
    CONTROL         "", 1332, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP, 0, 0, 10, 16
    LTEXT           "", 1352, 0, 0, 10, 8
    LTEXT           "", 1323, 0, 0, 10, 8
    LTEXT           "", 1343, 0, 0, 10, 8
    CONTROL         "", 1333, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP, 0, 0, 10, 16
    LTEXT           "", 1353, 0, 0, 10, 8
    PUSHBUTTON      "&Display Settings...", 1361, 7, 179, 75, 14
    DEFPUSHBUTTON   "OK", IDOK, 116, 179, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 179, 50, 14
END
