#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "common.rc"

IDI_MAIN ICON "pipes.ico"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION     "3D Pipes (Remake)"
    IDS_TEXTURE_FILTER  "Image Files (*.bmp;*.jpg;*.png;*.gif)#*.bmp;*.jpg;*.jpeg;*.png;*.gif#"
    IDS_TEXTURE_TITLE   "Choose Texture File"
    4001                "Elbow"
    4002                "Ball"
    4003                "Mixed"
    4004                "Cycle"
END

IDD_CONFIG DIALOGEX 0, 0, 227, 162
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "3D Pipes Settings"
FONT 8, "MS Shell Dlg"
BEGIN
    GROUPBOX        "Pipes", -1, 7, 7, 100, 44
    AUTORADIOBUTTON "&Single", IDC_SINGLE, 14, 20, 80, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Multiple", IDC_MULTIPLE, 14, 33, 80, 10
    GROUPBOX        "Pipe Style", -1, 115, 7, 105, 44
    LTEXT           "&Joint Type:", -1, 121, 20, 90, 8
    COMBOBOX        IDC_JOINT_TYPE, 121, 31, 92, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    GROUPBOX        "Surface Style", -1, 7, 56, 213, 44
    AUTORADIOBUTTON "S&olid", IDC_SOLID, 14, 69, 80, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Te&xtured", IDC_TEXTURED, 14, 82, 80, 10
    PUSHBUTTON      "&Choose Texture...", IDC_CHOOSE_TEXTURE, 128, 74, 84, 14, WS_GROUP
    GROUPBOX        "Speed", -1, 7, 105, 213, 32
    LTEXT           "Slow", -1, 14, 119, 20, 8
    CONTROL         "", IDC_SPEED, TRACKBAR_CLASS, TBS_AUTOTICKS | TBS_HORZ | WS_TABSTOP, 36, 116, 150, 16
    LTEXT           "Fast", -1, 192, 119, 20, 8
    PUSHBUTTON      "&Display Settings...", IDC_DISPLAY_SETTINGS, 7, 142, 75, 14
    DEFPUSHBUTTON   "OK", IDOK, 116, 142, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 142, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "3D Pipes Screen Saver (Remake)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Pipes"
            VALUE "OriginalFilename", "Pipes.scr"
            VALUE "ProductName", "Screen Saver Reverse Engineering"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
