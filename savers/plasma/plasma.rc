IDI_MAIN ICON "plasma.ico"

STRINGTABLE
BEGIN
    IDS_DESCRIPTION  "Plasma"
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
